    "sci-e-solid-liquid-gas"
  ],
  "leads_to": [
    "sci-e-heat-transfer"
  ],
  "learning_objectives": [
    "能说出温度表示物体的冷热程度，知道温度的单位是摄氏度",
    "能正确读出温度计的示数，知道读数时视线要与液柱上表面相平",
    "能说出一般物体受热体积膨胀、遇冷体积收缩，并用它解释身边的现象",
    "知道水结成冰体积反而变大，能举例说明热胀冷缩的应用"
  ],
  "curriculum_standards": [
    {
      "content": "描述测量物体温度的方法，知道温度的单位是摄氏度，能正确使用温度计读数",
