{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "PBL Semester Coverage Pack",
  "type": "object",
  "required": ["id", "model", "grade", "semester", "projects", "nodePoolSize"],
  "properties": {
    "model": { "const": "semester-coverage-pack" },
    "id": { "type": "string" },
    "grade": { "type": "integer", "minimum": 1, "maximum": 12 },
    "semester": { "enum": ["autumn", "spring"] },
    "nodePoolSize": { "type": "integer" },
    "projectCount": { "type": "integer" },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "title", "mandatoryNodeIds", "certifiedNodeIds"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "weeks": { "type": "integer" },
          "mandatoryNodeIds": { "type": "array", "items": { "type": "string" } },
          "certifiedNodeIds": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  }
}
