    { "week": 3, "phase": "investigate", "focus": "问卷/采访设计", "teacher": ["反馈问卷措辞", "信息保护提醒"], "student": ["设计工具", "预调查 5 人"] },
    { "week": 4, "phase": "investigate", "focus": "正式调查", "teacher": ["检核样本量说明"], "student": ["社区采样", "记录原始数据"] },
    { "week": 5, "phase": "analyze", "focus": "统计与图表", "teacher": ["引导选中位数还是平均数"], "student": ["计算+作图", "写数据结论段"] },
    { "week": 6, "phase": "synthesize", "focus": "需求地图", "teacher": ["地图要素反馈"], "student": ["绘制社区需求地图", "标注优先级"] },
    { "week": 7, "phase": "synthesize", "focus": "改进提案", "teacher": ["可行性追问"], "student": ["倡议书/提案", "英文摘要（可选）"] },
    { "week": 8, "phase": "present", "focus": "答辩 · 覆盖自检", "teacher": ["覆盖快照", "班级差异度"], "student": ["展示", "自评节点运用"] }
